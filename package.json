{
  "name": "facetedflight2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "description": "Faceted Flight 2 — WebXR arcade stunt flight. A port of the 2016 Unity VR game (Steam 355230) to three.js + WebXR, then a sequel.",
  "author": "Uncle Matt Makes",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node .githooks/install.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:rooms": "tsc --noEmit -p workers/rooms",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node tools/test/tiered.mjs",
    "test:changed": "node tools/test/tiered.mjs --changed",
    "test:related": "vitest related --run",
    "e2e": "playwright test",
    "e2e:all": "node tools/test/e2e-env.mjs",
    "e2e:measure": "node tools/test/e2e-env.mjs --grep @measure",
    "e2e:changed": "node tools/test/e2e-changed.mjs",
    "e2e:smoke": "playwright test boot.spec.ts menu-screen.spec.ts completion.spec.ts --grep \"boots, paints|boards you on confirm|it is on the board\"",
    "e2e:shaders": "playwright test shader-link.spec.ts --workers 2",
    "e2e:install": "playwright install chromium",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm test:smoke",
    "extract": "pnpm extract:constants && pnpm extract:props && pnpm extract:levels && pnpm bake:placements && pnpm extract:palettes",
    "extract:palettes": "node tools/extract/palette.mjs",
    "extract:constants": "node tools/extract/constants.mjs",
    "extract:levels": "node tools/extract/level.mjs --all",
    "extract:props": "node tools/extract/props.mjs",
    "extract:ghosts": "node tools/extract/ghost.mjs --mission int_01_hoverJet",
    "extract:manifest": "node tools/extract/check-content.mjs",
    "extract:check": "node tools/extract/constants.mjs --check && node tools/extract/palette.mjs --check && node tools/extract/check-content.mjs --check",
    "extract:check:full": "pnpm extract:check && node tools/extract/check-content.mjs --check --full",
    "bake:placements": "node tools/assets/bake-placements.mjs",
    "assets:pull": "rclone copy r2-ff2:ff2-content/assets public/assets --transfers 16 --checkers 16",
    "assets:check": "node tools/assets/check-assets-present.mjs --verify-hashes",
    "content:pack": "node tools/assets/build-content-pack.mjs",
    "content:pull": "node tools/assets/pull-content-pack.mjs",
    "stats": "node tools/stats/stats.mjs",
    "assets:push": "rclone copy public/assets r2-ff2:ff2-content/assets --transfers 16 --checkers 16 --s3-no-check-bucket --exclude \"*.bak\" --exclude \"*.tmp\" --exclude \"*~\" --exclude \"*-trees.png\"",
    "release:list": "node tools/release/copy-list.mjs",
    "public:export": "node tools/release/export-public.mjs",
    "public:drift": "node tools/release/export-public.mjs --drift",
    "audit:security": "node tools/security/audit.mjs",
    "oracle:sweep": "python tools/terrain/oracle-sweep.py --terrain simonet.islands --out tools/terrain/.oracle/simonet.islands.json --dump 0,0:3,3:6,6:8,3:8,8:9,11:10,13:12,4:12,12:5,13 --dump-dir tools/terrain/.oracle"
  },
  "dependencies": {
    "@fontsource/bitter": "5.2.10",
    "@fontsource/roboto-condensed": "5.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "iwer": "^2.4.0",
    "lil-gui": "^0.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
