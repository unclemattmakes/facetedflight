{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "maxSize": 2097152,
    "includes": [
      "**",
      "!public",
      "!dist",
      "!src/generated",
      "!content",
      "!data/generated",
      "!**/*.generated.ts",
      "!**/*.generated.json",
      "!docs",
      "!tools/prototype",
      "!tools/wf-*.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "warn" },
      "style": {
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "warn"
      }
    }
  }
}
